---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const recentPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title="ホーム" description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main>
      <article>
        <h1>ようこそ</h1>

        <p>Hoshiのホームページへようこそ</p>

        <p>
          ソースコードは<a
            href="https://github.com/shivasaki/cuprite"
            target="_blank"
            rel="noopener noreferrer">こちら</a
          >で公開しています。
        </p>
      </article>

      <section class="recent-posts">
        <h2>最新の記事</h2>
        <ul>
          {
            recentPosts.map((post) => (
              <li>
                <a href={`/blog/${post.slug}`}>
                  <p class="date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                  <h3>{post.data.title}</h3>
                  <p class="description">{post.data.description}</p>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="all-posts" href="/blog">すべての記事を見る →</a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .recent-posts {
    margin-top: 3rem;
  }
  .recent-posts h2 {
    font-size: 1.563em;
    margin-bottom: 1.5rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  li a {
    display: block;
    text-decoration: none;
    color: inherit;
    background: white;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
    padding: 1.25rem 1.5rem;
    transition: box-shadow 0.2s;
  }
  li a:hover {
    box-shadow: 0 4px 12px rgba(var(--gray), 40%), 0 12px 32px rgba(var(--gray), 40%);
  }
  .date {
    font-size: smaller;
    color: rgb(var(--gray));
    margin: 0 0 0.25rem;
  }
  h3 {
    font-size: 1.1em;
    margin: 0 0 0.25rem;
    color: rgb(var(--black));
  }
  .description {
    font-size: smaller;
    color: rgb(var(--gray-dark));
    margin: 0;
  }
  .all-posts {
    font-size: smaller;
    color: var(--accent);
  }
</style>
