---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title="ホーム" description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main>
      <article>
        <h1>ようこそ</h1>

        <p>Hoshiのホームページへようこそ</p>

        <p>
          ソースコードは<a
            href="https://github.com/shivasaki/cuprite"
            target="_blank"
            rel="noopener noreferrer">こちら</a
          >で公開しています。
        </p>
      </article>
    </main>
    <Footer />
  </body>
</html>
