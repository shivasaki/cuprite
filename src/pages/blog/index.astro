---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title="ブログ" description="hoshiのブログ" />
  </head>
  <body>
    <Header />
    <main>
      <h1>ブログ</h1>
      <ul>
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}`}>
                <div class="post-card">
                  {post.data.heroImage && (
                    <img src={post.data.heroImage} alt={post.data.title} />
                  )}
                  <div class="content">
                    <p class="date">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                    <h2>{post.data.title}</h2>
                    <p class="description">{post.data.description}</p>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
    <Footer />
  </body>
</html>

<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    margin-bottom: 2rem;
  }
  li a {
    text-decoration: none;
    color: inherit;
  }
  .post-card {
    background: white;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
    overflow: hidden;
    transition: box-shadow 0.2s;
  }
  .post-card:hover {
    box-shadow: 0 4px 12px rgba(var(--gray), 40%), 0 12px 32px rgba(var(--gray), 40%);
  }
  .post-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 12px 12px 0 0;
  }
  .content {
    padding: 1.5rem 2rem;
  }
  .date {
    font-size: smaller;
    color: rgb(var(--gray));
    margin: 0 0 0.25rem;
  }
  h2 {
    font-size: 1.25em;
    margin: 0 0 0.5rem;
    color: rgb(var(--black));
  }
  .description {
    font-size: smaller;
    color: rgb(var(--gray-dark));
    margin: 0;
  }
</style>
